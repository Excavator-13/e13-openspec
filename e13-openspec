#!/usr/bin/env zsh
#
# e13-openspec — 初始化 .agents/ 和 openspec/
#
# 用法:
#   cd /path/to/project
#   e13-openspec init          # 已存在的目录会跳过
#   e13-openspec init -f       # 已存在的目录会先删除再复制

emulate -L zsh
set -e

# ${0:A:h} = 脚本自身的绝对路径所在目录（zsh 特有的展开）
script_dir="${0:A:h}"
src_dir="${script_dir}/templates"

usage() {
  print -r -- "用法: e13-openspec <命令>"
  print -r -- ""
  print -r -- "命令:"
  print -r -- "  init [-f]   将 .agents/ 和 openspec/ 复制到当前目录"
}

case "${1:-}" in
  init)
    force=0
    [[ "${2:-}" == "-f" || "${2:-}" == "--force" ]] && force=1

    for d in .agents openspec; do
      if [[ ! -d "${src_dir}/${d}" ]]; then
        print -u2 "错误: 模板目录不存在: ${src_dir}/${d}"
        exit 1
      fi

      if [[ -e "${PWD}/${d}" ]]; then
        if (( force )); then
          print -u2 "删除已存在的 ${d} ..."
          rm -rf -- "${PWD}/${d}"
        else
          print -u2 "跳过 ${d}（已存在，加 -f 可覆盖）"
          continue
        fi
      fi

      cp -R -- "${src_dir}/${d}" "${PWD}/"
      print "✓ 已复制 ${d}"
    done
    ;;

  ""|help|-h|--help)
    usage
    ;;

  *)
    print -u2 "未知命令: $1"
    usage >&2
    exit 1
    ;;
esac