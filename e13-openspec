#!/usr/bin/env bash
#
# e13-openspec — 初始化 .agents/ 和 openspec/
#
# 用法:
#   cd /path/to/project
#   e13-openspec init          # 已存在的目录会跳过
#   e13-openspec init -f       # 已存在的目录会先删除再复制

set -e

script_dir="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
src_dir="${script_dir}/templates"

usage() {
  echo "用法: e13-openspec <命令>"
  echo ""
  echo "命令:"
  echo "  init [-f]   将 .agents/ 和 openspec/ 复制到当前目录"
}

case "${1:-}" in
  init)
    force=0
    [[ "${2:-}" == "-f" || "${2:-}" == "--force" ]] && force=1

    for d in .agents openspec; do
      if [[ ! -d "${src_dir}/${d}" ]]; then
        echo "错误: 模板目录不存在: ${src_dir}/${d}" >&2
        exit 1
      fi

      if [[ -e "${PWD}/${d}" ]]; then
        if (( force )); then
          echo "删除已存在的 ${d} ..." >&2
          rm -rf -- "${PWD}/${d}"
        else
          echo "跳过 ${d}（已存在，加 -f 可覆盖）" >&2
          continue
        fi
      fi

      cp -R -- "${src_dir}/${d}" "${PWD}/"
      echo "✓ 已复制 ${d}"
    done
    ;;

  ""|help|-h|--help)
    usage
    ;;

  *)
    echo "未知命令: $1" >&2
    usage >&2
    exit 1
    ;;
esac